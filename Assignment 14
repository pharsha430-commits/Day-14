Select any of the country from "Country selection" dropdown ( https://practice.expandtesting.com/dropdown) and print the result in console.
package selepractice;

import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.Select;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;

public class Dropdown_Single2 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		String url = "https://practice.expandtesting.com/dropdown";
		String id = "country";
		
		WebDriver driver = new ChromeDriver();
		driver.manage().window().maximize();
		driver.get(url);
		WebElement dropdown = driver.findElement(By.id(id));
		Select options = new Select (dropdown);
		options.selectByValue("HK");
		WebElement selection = options.getFirstSelectedOption();
		
		System.out.println(selection.getText());
		

	}

}
